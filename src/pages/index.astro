  '@type': 'Person',
  name: 'Hanbin Hong',
  url: meta.site,
  image: meta.image,
  jobTitle: 'Research Scientist',
  worksFor: {
    '@type': 'Organization',
    name: 'TikTok (ByteDance)',
  },
