    featured: true,
    links: [
      { label: 'Paper', href: links.paper },
      { label: 'Leaderboard', href: links.leaderboard },
      { label: 'Data', href: links.jailbreakDb },
      { label: 'Code', href: links.promptSecurity },
    ],
  },
  {
